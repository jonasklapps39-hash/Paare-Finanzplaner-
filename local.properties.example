# Kopiere diese Datei nach local.properties und trage deine Werte ein.
# local.properties wird nicht eingecheckt.
sdk.dir=/pfad/zu/Android/sdk

# Optional: anderes Supabase-Projekt als das in supabase.properties (Dashboard → Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Optional: OAuth-Client-ID (Typ "Web") aus der Google Cloud Console für "Mit Google anmelden"
GOOGLE_WEB_CLIENT_ID=
